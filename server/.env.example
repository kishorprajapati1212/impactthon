# ── AttendX Server - Environment Variables ────────────────────────────
# Copy to .env:  cp .env.example .env

PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────
# For MongoDB Atlas (free tier): mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/attendx_db
# For local: mongodb://localhost:27017/attendx_db
# For Docker: mongodb://mongo:27017/attendx_db
MONGODB_URI=mongodb://localhost:27017/attendx_db

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=attendx_dev_2026_change_this_to_random_32_chars_in_prod
JWT_EXPIRE=7d

# ── Demo data ─────────────────────────────────────────────────────────
# AUTO_SEED=true loads the demo college ONLY when the database is empty.
# Wipe + reload:  FORCE_SEED=true node seed/seed.js   (or ./reseed.sh with Docker)
AUTO_SEED=true

# ── Browser origins ───────────────────────────────────────────────────
# Normally irrelevant: the UI calls the API on its OWN origin under /api/*
# (Vite proxy in dev, nginx in Docker), so no cross-origin request happens.
# Only when the UI is hosted on another domain: list it here, or CORS_OPEN=true.
FRONTEND_URL=http://localhost:5173
CORS_OPEN=true
REDIS_URL=

# Reseed from a PaaS dashboard (Render, Railway…) where you have no shell:
# set to any NEW value and redeploy → wipes + reloads the demo college once,
# then remembers the value. Same value later = no change. Remove when done.
# RESEED_KEY=2026-11-03a
