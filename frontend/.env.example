# ── AttendX Frontend ──────────────────────────────────────────────────
# Copy: cp .env.example .env
#
# LOCAL / Docker:
#   VITE_API_URL=http://localhost:3000
#
# PROJECT IDX:
#   Leave VITE_API_URL empty — axios auto-maps
#     https://5173-<workspace>.cloudworkstations.dev
#   →  https://3000-<workspace>.cloudworkstations.dev
#
#   OR paste the full API URL from IDX Ports panel (port 3000):
#   VITE_API_URL=https://3000-xxxxxxxx.cloudworkstations.dev
#
# VITE_API_URL=
